# Copy this file to .env for local testing. On Render, add these in the Environment tab instead.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/classroom?retryWrites=true&w=majority
API_KEY=change-this-to-a-long-random-secret
# Your Netlify URL without a trailing slash (use * while testing)
FRONTEND_ORIGIN=*
